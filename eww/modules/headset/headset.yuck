(deflisten headset_battery :initial '{"percent": -1, "available": false, "charging": false}'
  "modules/headset/headset.sh")

(defwidget headset_battery []
  (box :class "date-widget headset-battery ${headset_battery.charging ? "charging" : ""} ${!headset_battery.charging && headset_battery.percent >= 0 && headset_battery.percent < 5 ? "low" : ""}"
    :orientation "v" :space-evenly false
    :visible {headset_battery.available}
    (label :class "headset-icon" :text {headset_battery.charging ? "󰋎󱐋" : "󰋎"} :halign "center" :vexpand true)
    (label :class "headset-percent" :text "${headset_battery.percent}%" :halign "start")
  )
)
